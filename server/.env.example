# Local server configuration. Copy to .env; never commit credentials.
AWS_REGION=us-east-2
# Bedrock uses the standard AWS credential chain (AWS_PROFILE, IAM role, etc.).
# AWS_PROFILE=

# Initial defaults only; a saved Admin > AI Settings selection takes precedence.
AI_PROVIDER=bedrock
WORKERS_AI_MODEL=@cf/deepseek-ai/deepseek-v4.1-flash-1017

# Cloudflare Workers AI REST API credentials, used only on the server.
# Create an account-scoped token with Workers AI Read and Edit permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# One-time browser connection setup; see docs/CLOUDFLARE_OAUTH.md.
# Use an authorization_code + refresh_token client with PKCE and auth method
# "none", or "client_secret_post" with the optional secret below.
CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this stable and identical on every API/streaming server instance.
CLOUDFLARE_OAUTH_ENCRYPTION_KEY=
# Exact registered callback is APP_URL + /v1/oauth/cloudflare/callback.
# APP_URL=http://localhost:3000

# Optional local overrides. dev-sqlite.js supplies development defaults.
# PORT=3000
# JWT_SECRET=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
