rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == "allthesecrushes@gmail.com" ||
        request.auth.token.email == "henry@lakefrontdigital.io" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'platoUserId', 'name', 'username', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'platoUserId', 'name', 'username', 'role', 'userGroup', 'createdAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_-]+$')
        && data.platoUserId is string && data.platoUserId.size() >= 1 && data.platoUserId.size() <= 128 && data.platoUserId.matches('^[a-zA-Z0-9_-]+$')
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.username is string && data.username.size() >= 3 && data.username.size() <= 30 && data.username.matches('^[a-zA-Z0-9_-]+$')
        && data.role is string && data.role.size() >= 4 && data.role.size() <= 10 && (data.role == 'user' || data.role == 'admin')
        && (!('userGroup' in data) || (data.userGroup is string && data.userGroup.size() <= 100))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_-]+$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSyncRecord(data) {
      return data.keys().hasAll(['uid', 'dataKey', 'payload', 'version', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'dataKey', 'payload', 'version', 'createdAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_-]+$')
        && data.dataKey is string && data.dataKey.size() >= 1 && data.dataKey.size() <= 128
        && data.payload is string && data.payload.size() >= 1 && data.payload.size() <= 389120
        && data.version is int && data.version >= 1
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'createdAt'])
        && data.keys().hasOnly(['uid', 'createdAt'])
        && data.uid == request.auth.uid
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_-]+$')
        && data.createdAt is timestamp;
    }

    // 4. Collection Rules

    // Public User Profiles (Non-PII)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;

      allow create: if isVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && isOwner(userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().role == 'user' || isAdmin());

      allow update: if isVerified()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().platoUserId == existing().platoUserId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Owner updates profile metadata (cannot change role)
          (isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'username', 'userGroup', 'updatedAt']))
          ||
          // Action 2: Admin updates profile or role
          isAdmin()
        );

      allow delete: if isVerified() && isValidId(userId) && (isOwner(userId) || isAdmin());

      // Isolated PII Subcollection (Split Collection Strategy)
      match /private/{docId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(docId)
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if false;

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(docId)
          && isValidUserPrivateInfo(incoming())
          && isOwner(userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(docId)
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (isOwner(userId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']))
            || isAdmin()
          )
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(docId)
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId));
      }

      // Synchronized Microlearning Records Subcollection
      match /syncData/{syncId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(syncId)
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isSignedIn()
          && (
            isOwner(userId) ||
            (isVerified() && (
              request.auth.token.email == "allthesecrushes@gmail.com" ||
              request.auth.token.email == "henry@lakefrontdigital.io"
            ))
          );

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(syncId)
          && isValidSyncRecord(incoming())
          && isOwner(userId)
          && incoming().dataKey == syncId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(syncId)
          && isValidSyncRecord(incoming())
          && incoming().uid == existing().uid
          && incoming().dataKey == existing().dataKey
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (isOwner(userId)
              && incoming().version == existing().version + 1
              && incoming().diff(existing()).affectedKeys().hasOnly(['payload', 'version', 'updatedAt']))
            || isAdmin()
          )
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(syncId)
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }

    // Trusted Admin Marker Collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if false;

      allow create: if isVerified()
        && isValidId(adminId)
        && isValidAdminRecord(incoming())
        && isOwner(adminId)
        && incoming().createdAt == request.time
        && isAdmin();

      allow update: if false;
      allow delete: if isVerified() && isValidId(adminId) && isAdmin();
    }
  }
}
