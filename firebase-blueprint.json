{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public user profile metadata stored for each plato learner or administrator.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID of the user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "platoUserId": {
          "type": "string",
          "description": "Corresponding plato internal userId.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Display name of the learner or admin.",
          "minLength": 1,
          "maxLength": 120
        },
        "username": {
          "type": "string",
          "description": "Unique alphanumeric handle for the user.",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "description": "Role in the classroom.",
          "enum": ["user", "admin"],
          "minLength": 4,
          "maxLength": 10
        },
        "userGroup": {
          "type": "string",
          "description": "Optional classroom cohort or user group.",
          "minLength": 0,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was last updated."
        }
      },
      "required": ["uid", "platoUserId", "name", "username", "role", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Strictly isolated PII document containing the user's email address.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID of the user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address of the user.",
          "minLength": 3,
          "maxLength": 254
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the private record was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the private record was last updated."
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "SyncRecord": {
      "title": "SyncRecord",
      "description": "Synchronized learning record (profile, preferences, lessonKB, activities, messages) belonging to a user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID of the owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dataKey": {
          "type": "string",
          "description": "Sync record key identifier.",
          "minLength": 1,
          "maxLength": 128
        },
        "payload": {
          "type": "string",
          "description": "Serialized sync record payload bounded to 380 KB.",
          "minLength": 1,
          "maxLength": 389120
        },
        "version": {
          "type": "integer",
          "description": "Monotonically increasing optimistic lock version."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the sync record was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the sync record was last updated."
        }
      },
      "required": ["uid", "dataKey", "payload", "version", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator marker document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase UID of the administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the admin record was created."
        }
      },
      "required": ["uid", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Public user profile documents indexed by Firebase UID."
    },
    "/users/{userId}/private/{docId}": {
      "schema": "UserPrivateInfo",
      "description": "Isolated PII subcollection storing the user's private email address."
    },
    "/users/{userId}/syncData/{syncId}": {
      "schema": "SyncRecord",
      "description": "Per-user synchronized microlearning records."
    },
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "Trusted admin lookup collection."
    }
  }
}
