{
  "name": "plato",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "scripts": {
    "build:client": "cd client && npm run build",
    "build:server": "cd server && sam build",
    "build": "npm run build:client",
    "dev": "npm run build:client && npm run dev:server",
    "start": "npm run dev:server",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev:sqlite",
    "test:client": "cd client && npm test",
    "test:server": "cd server && npm test",
    "test": "npm run test:client && npm run test:server",
    "deploy": "npm run build:client && npm run build:server && cd server && sam deploy"
  },
  "dependencies": {
    "firebase": "^13.0.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "eslint": "^10.13.0"
  }
}
